          16,
          17,
          18
        ],
        "title": {
          "tr": "Dostluk Mücadelesiyle saldırı provası",
          "en": "Attack practice with Friendly Challenges"
        },
        "summary": {
          "tr": "Kupa veya kaynak kaybetmeden girişini, yönlendirmeyi ve zamanlamayı tekrar ederek saldırı planını geliştir.",
          "en": "Improve your attack plan by repeating the entry, funnel and timing without risking trophies or resources."
        },
        "steps": {
          "tr": [
            "Klan arkadaşından hedef düzene uygun bir Dostluk Mücadelesi paylaşmasını iste.",
            "Saldırıdan önce kullanacağın orduyu normal eğitim ekranında eksiksiz hazırla.",
            "İlk denemede giriş ve yönlendirmeye odaklan; birliklerin rotadan nerede saptığını not et.",
            "Aynı planı küçük zamanlama değişiklikleriyle tekrar dene ve en tutarlı yaklaşımı seç."
          ],
          "en": [
            "Ask a clanmate to share a Friendly Challenge with a suitable target layout.",
            "Prepare the complete army you plan to use in the normal training screen before attacking.",
            "Focus on the entry and funnel in the first attempt; note where troops leave the intended path.",
            "Repeat the same plan with small timing changes and choose the most consistent approach."
          ]
        },
        "updated": "2026-11-16",
        "kind": "general",
        "sourceUrls": [
          "https://support.supercell.com/clash-of-clans/en/articles/friendly-challenges-3.html"
        ]
      },
      "fingerprint": "a2607d38a6c0d127ab1d07fc9158376959eb3dc087c79cd4a457a8841735a395"
    },
